# Copy this file to .env and fill in what you use. .env is gitignored; never commit keys.
# Every value here can also be set in the web app's LLM settings tab for one session.

# Which model the CLI uses, and which preset the web app starts on: mock | ollama | openai
SCRA_LLM=mock
# Web app only: start on a specific preset instead
# (mock, ollama, lmstudio, groq, gemini, openrouter, openai, custom)
# SCRA_PRESET=groq

# --- Ollama (local, free) ---
SCRA_OLLAMA_URL=http://localhost:11434
SCRA_OLLAMA_MODEL=qwen2.5-coder:7b

# --- Any OpenAI-compatible server (used when SCRA_LLM=openai) ---
# LM Studio: http://localhost:1234/v1   Groq: https://api.groq.com/openai/v1
# SCRA_OPENAI_BASE_URL=http://localhost:1234/v1
# SCRA_OPENAI_MODEL=qwen2.5-coder-7b-instruct
# SCRA_OPENAI_API_KEY=

# --- Keys picked up by the web app's presets ---
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# --- Limits ---
# seconds per model call
SCRA_LLM_TIMEOUT=120
# seconds for a whole review
SCRA_AGENT_DEADLINE=240

# --- Other ---
# CLI: use the bundled advisory snapshot instead of live OSV
# SCRA_OFFLINE=1
# 0.0.0.0 to accept connections from other machines
# SCRA_HOST=127.0.0.1
# SCRA_PORT=7860
# public deployment: hosted presets only, no custom server URLs
# SCRA_HOSTED=1
# SCRA_LOG_DIR=logs
# SCRA_DISABLE_LOGS=1
# only if Semgrep is not on PATH or in the virtualenv
# SCRA_SEMGREP=/path/to/semgrep
